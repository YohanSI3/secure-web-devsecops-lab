# Jails actives pour ce lab. Voir fail2ban/README.md pour les choix
# (pourquoi ces jails, ces seuils, pas d'intégration ufw) et Notes/fail2ban/
# pour le fonctionnement général de fail2ban.
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
# Le paquet fail2ban d'Ubuntu (/etc/fail2ban/jail.d/defaults-debian.conf,
# chargé avant ce fichier) force `backend = systemd` par défaut : sans
# cette ligne, nos jails écoutent le journal systemd au lieu des fichiers
# `logpath` déclarés ci-dessous — et Nginx n'écrit jamais dans le journal
# (il écrit directement dans ses fichiers access_log), donc les jails ne
# voient jamais rien. Voir fail2ban/README.md pour le détail de cette
# découverte.
backend  = pyinotify

# Ports des 3 vhosts du lab (voir firewall/README.md) : toute règle ici doit
# rester synchronisée avec les ports réellement ouverts côté ufw et nginx.
[nginx-botsearch]
enabled  = true
port     = 80,443,8080,8443,8081,8444
filter   = nginx-botsearch
logpath  = /var/log/nginx/secure-web-lab-*.access.log

[nginx-404-flood]
enabled  = true
port     = 80,443,8080,8443,8081,8444
filter   = nginx-404-flood
logpath  = /var/log/nginx/secure-web-lab-*.access.log
maxretry = 10
findtime = 5m
bantime  = 1h

# Le paquet fail2ban d'Ubuntu active cette jail par défaut, via
# /etc/fail2ban/jail.d/defaults-debian.conf (fichier livré par le paquet,
# non versionné ici) — sans rapport avec ce dépôt. Désactivée explicitement
# pour rester cohérent avec le choix déjà documenté dans
# firewall/README.md : aucun sshd n'écoute sur cette machine (accès via
# l'intégration WSL, pas par le réseau), donc rien à surveiller ici.
[sshd]
enabled = false
