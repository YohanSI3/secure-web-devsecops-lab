PORT=3000

# Depuis Phase 4 (gestion des secrets), DATABASE_URL et SESSION_SECRET ne
# sont plus lus depuis ce fichier : récupérés dynamiquement depuis Vault
# au démarrage (voir src/vault.js, app/backend/README.md#vault et
# vault/README.md). Seule l'identité AppRole du backend (machine), pas
# les secrets applicatifs eux-mêmes, vit encore dans ce fichier.
VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROLE_ID=changeme
# Jamais une valeur réelle dans ce fichier .env.example -- voir
# vault/README.md pour comment obtenir un vrai role_id/secret_id
# (scripts/setup-vault-approle.sh).
VAULT_SECRET_ID=changeme
